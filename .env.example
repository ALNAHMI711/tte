# Never commit real credentials.
APP_ENV=development
LIVE_TRADING=false
PAPER_TRADING=true
ADMIN_AUTH_REQUIRED=true
SESSION_SECRET=replace-with-a-long-random-secret
SECRET_MASTER_KEY=replace-with-a-long-random-secret-at-least-32-characters
SESSION_STORE_BACKEND=memory
SESSION_STORE_PATH=
SESSION_TTL_SECONDS=3600
SESSION_STEP_UP_SECONDS=300
PAPER_STORE_BACKEND=sqlite
PAPER_STORE_PATH=
PAPER_STORE_DSN=
ADMIN_USER_ID=
ADMIN_PASSWORD_HASH=
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_TESTNET=true
