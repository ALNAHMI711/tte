# Never commit real credentials.
APP_ENV=development
LIVE_TRADING=false
PAPER_TRADING=true
ADMIN_AUTH_REQUIRED=true
SESSION_SECRET=replace-with-a-long-random-secret
SECRET_MASTER_KEY=replace-with-a-long-random-secret-at-least-32-characters
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_TESTNET=true
